# Variables de entorno del sistema de gestión comercial.
# Copiar este archivo como .env (no se versiona) y ajustar los valores.

# URL de la base de datos.
# - Desarrollo: SQLite local, p. ej. file:local.db (es el valor por defecto si se omite).
# - Producción: URL de Turso, p. ej. libsql://<base>-<organizacion>.turso.io
DATABASE_URL=file:local.db

# Token de acceso de Turso. Obligatorio solo si DATABASE_URL es remota.
# Se obtiene con: turso db tokens create <base>
# Nunca escribir un token real en este archivo.
DATABASE_AUTH_TOKEN=
